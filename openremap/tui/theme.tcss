/* OpenRemap TUI — one accent, dark, no chrome noise. */

Screen {
    background: #0b0f14;
    color: #c8d1e0;
}

/* ── boot screen ─────────────────────────────────────────────────────── */

#boot-center {
    width: 100%;
    height: 100%;
    align: center middle;
}

#boot-panel {
    width: 90;
    height: auto;
    padding: 1 2;
}

#boot-wordmark {
    color: #4ad6a8;
    text-style: bold;
    width: 1fr;
    text-align: center;
}

#boot-tagline {
    color: #5a6b85;
    text-align: center;
    padding: 0 0 1 0;
}

#boot-steps {
    height: auto;
    padding: 1 0;
}

.boot-step {
    width: 1fr;
    height: 1;
}

.step-label {
    width: 15;
    height: 1;
    padding: 0 0 0 1;
}

.step-detail {
    width: 1fr;
    height: 1;
}

.step-timing {
    width: 9;
    height: 1;
    text-align: right;
}

.boot-step.pending {
    color: #3a4557;
}

.boot-step.running {
    color: #8aa0c0;
}

.boot-step.ok {
    color: #c8d1e0;
}

.boot-step.failed {
    color: #ff6b6b;
    text-style: bold;
}

#boot-progress {
    width: 1fr;
    height: 1;
    margin: 1 0 1 1;
    color: #4ad6a8;
}

.boot-status {
    width: 1fr;
    height: auto;
    padding: 0 0 0 1;
    color: #8aa0c0;
}

.boot-status.dim {
    color: #5a6b85;
}

.boot-status.ready {
    color: #4ad6a8;
    text-style: bold;
}

.boot-status.failed {
    color: #ff6b6b;
    text-style: bold;
}

#boot-repair {
    width: 1fr;
    height: auto;
    border: round #ff6b6b;
    color: #ffd7d7;
    padding: 0 1;
    margin: 1 0 0 0;
}

/* ── home ────────────────────────────────────────────────────────────── */

#home-panel {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

#home-title {
    color: #e8eef7;
    text-style: bold;
    padding: 0 0 1 1;
}

.card-row {
    height: auto;
}

.card {
    width: 1fr;
    height: 5;
    margin: 0 1 1 0;
    padding: 0 1;
    border: round #1e2a38;
    background: #0e141b;
    color: #c8d1e0;
}

.card:hover {
    border: round #2f4256;
    background: #111922;
}

.card.focused {
    border: round #4ad6a8;
    background: #101b18;
}

#home-recent {
    width: 1fr;
    height: auto;
    padding: 1 1 0 1;
}

#home-status {
    width: 1fr;
    height: 1;
    dock: bottom;
    padding: 0 0 0 1;
    background: #0b0f14;
}

#home-status-left {
    width: 1fr;
    height: 1;
}

#home-status-hints {
    width: auto;
    height: 1;
    color: #5a6b85;
}

/* ── identify ────────────────────────────────────────────────────────── */

#identify-panel {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

#identify-file {
    height: 3;
    border: round #1e2a38;
    padding: 0 1;
    margin: 0 0 1 0;
}

#identify-file-path {
    width: 1fr;
    height: 1;
    color: #c8d1e0;
}

#identify-file-meta {
    width: auto;
    height: 1;
    color: #5a6b85;
}

#identify-headline {
    width: 1fr;
    height: auto;
    padding: 0 0 1 1;
}

ActivityBar {
    width: 1fr;
    height: 1;
    color: #8aa0c0;
}

#identify-body {
    width: 1fr;
    height: auto;
    padding: 0 0 1 0;
}

#identify-analysis {
    width: 1fr;
    height: auto;
    padding: 1 0 0 0;
}

#identify-next {
    width: 1fr;
    height: auto;
    dock: bottom;
    padding: 1 0 1 1;
    border-top: solid #1e2a38;
}

/* ── file picker ─────────────────────────────────────────────────────── */

FilePicker {
    align: center middle;
}

#picker-panel {
    width: 80%;
    max-width: 96;
    height: 80%;
    border: round #2f4256;
    background: #0e141b;
    padding: 1 2;
}

#picker-title {
    color: #e8eef7;
    text-style: bold;
    padding: 0 0 1 0;
}

#picker-breadcrumb {
    height: 1;
    color: #5a6b85;
    padding: 0 0 0 0;
}

#picker-path {
    border: none;
    background: #111922;
    color: #c8d1e0;
}

#picker-tree {
    height: 1fr;
    background: #0e141b;
    padding: 1 0;
}

#picker-hint {
    color: #3a4557;
    dock: bottom;
    height: 1;
}

/* ── inspect ─────────────────────────────────────────────────────────── */

#inspect-panel {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

#inspect-file {
    height: 3;
    border: round #1e2a38;
    padding: 0 1;
    margin: 0 0 1 0;
}

#inspect-file-path {
    width: 1fr;
    height: 1;
    color: #c8d1e0;
}

#inspect-file-meta {
    width: auto;
    height: 1;
    color: #5a6b85;
}

#inspect-health,
#inspect-checksums,
#inspect-coherence,
#inspect-layout {
    width: 1fr;
    height: auto;
    padding: 0 0 0 1;
}

#inspect-next {
    width: 1fr;
    height: 3;   /* border 1 + padding 1 + one row of text */
    dock: bottom;
    padding: 1 0 0 1;
    border-top: solid #1e2a38;
}

/* ── maps ────────────────────────────────────────────────────────────── */

#maps-panel {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

#maps-head {
    height: 1;
}

#maps-file {
    width: 1fr;
    height: 1;
    color: #c8d1e0;
}

#maps-count {
    width: auto;
    height: 1;
    color: #5a6b85;
}

#maps-table {
    height: 1fr;
    background: #0e141b;
}

#maps-detail {
    height: 1;
    color: #8aa0c0;
}

#maps-profile {
    height: 1;
    color: #4ad6a8;
}

#maps-hints {
    height: 2;
    dock: bottom;
    padding: 0 0 0 1;
    color: #3a4557;
    border-top: solid #1e2a38;
}

/* ── cook ────────────────────────────────────────────────────────────── */

#cook-panel {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

#cook-title {
    height: 2;
    color: #5a6b85;
}

#cook-stock, #cook-tuned {
    height: 1;
    color: #c8d1e0;
}

#cook-basis {
    height: 2;
    color: #3a4557;
}

#cook-body {
    height: 1fr;
    color: #c8d1e0;
}

#cook-hints {
    height: 3;   /* border 1 + status row + key row */
    dock: bottom;
    padding: 0 0 0 1;
    color: #3a4557;
    border-top: solid #1e2a38;
}

/* ── apply ───────────────────────────────────────────────────────────── */

#apply-panel {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

#apply-title {
    height: 2;
    color: #5a6b85;
}

#apply-recipe, #apply-target {
    height: 1;
    color: #c8d1e0;
}

#apply-basis {
    height: 2;
    color: #3a4557;
}

#apply-body {
    height: 1fr;
    color: #c8d1e0;
}

#apply-hints {
    height: 3;   /* border 1 + status row + key row */
    dock: bottom;
    padding: 0 0 0 1;
    color: #3a4557;
    border-top: solid #1e2a38;
}

/* ── batch ───────────────────────────────────────────────────────────── */

#batch-panel {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

#batch-title {
    height: 1;
    color: #5a6b85;
}

#batch-folder {
    height: 1;
    color: #c8d1e0;
}

#batch-summary {
    height: 1;
    color: #8aa0c0;
}

#batch-body {
    height: 1fr;
}

#batch-table {
    height: 1fr;
    background: #0e141b;
}

#batch-plan {
    height: auto;
    max-height: 9;
    color: #8aa0c0;
}

#batch-hints {
    height: 3;   /* border 1 + up to two rows of keys */
    dock: bottom;
    padding: 0 0 0 1;
    color: #3a4557;
    border-top: solid #1e2a38;
}

/* ── help ────────────────────────────────────────────────────────────── */

#help-panel {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

#help-title {
    height: 1;
    color: #5a6b85;
}

#help-note {
    height: 3;
    color: #5a6b85;
}

#help-table {
    height: 1fr;
    background: #0e141b;
}

#help-hints {
    height: 2;   /* border 1 + one row of text */
    dock: bottom;
    padding: 0 0 0 1;
    color: #3a4557;
    border-top: solid #1e2a38;
}

/* ── recipe detail (modal) ───────────────────────────────────────────── */

RecipeDetailScreen {
    align: center middle;
}

#recipe-panel {
    width: 92%;
    height: 86%;
    padding: 1 2;
    background: #0e141b;
    border: round #25313f;
}

#recipe-title {
    height: 1;
    color: #4ad6a8;
}

#recipe-facts {
    height: 6;
    color: #8aa0c0;
}

#recipe-table {
    height: 1fr;
    background: #0b1016;
}

#recipe-hints {
    height: 1;
    color: #3a4557;
}

/* ── home: recent list ───────────────────────────────────────────────── */

#home-recent-title {
    height: 1;
    color: #5a6b85;
}

#home-recent {
    height: auto;
    max-height: 7;
    background: #0e141b;
}

#home-recent:focus {
    background: #0b1016;
}

#home-recent-empty {
    height: 1;
    color: #4b5a70;
}

/* ── prompt (modal) ──────────────────────────────────────────────────── */

PromptScreen {
    align: center middle;
}

#prompt-panel {
    width: 64;
    height: auto;
    padding: 1 2;
    background: #0e141b;
    border: round #25313f;
}

#prompt-question {
    height: 1;
    color: #c8d1e0;
}

#prompt-hint {
    height: auto;
    color: #5a6b85;
}

#prompt-keys {
    height: 1;
    color: #3a4557;
}

/* ── contribute ──────────────────────────────────────────────────────── */

#contribute-panel {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

#contribute-title {
    height: 2;
    color: #5a6b85;
}

#contribute-dumps, #contribute-names {
    height: auto;
    color: #c8d1e0;
}

#contribute-body {
    height: 1fr;
    color: #c8d1e0;
}

#contribute-hints {
    height: 2;   /* border 1 + one row of keys */
    dock: bottom;
    padding: 0 0 0 1;
    color: #3a4557;
    border-top: solid #1e2a38;
}
