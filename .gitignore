# ── Python generated ──────────────────────────────────────────────────────────
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/

# ── Virtual environment ───────────────────────────────────────────────────────
.venv/

# ── uv ────────────────────────────────────────────────────────────────────────
# uv.lock is intentionally committed — do not ignore it

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── Environment variables — never commit secrets ──────────────────────────────
.env
.env.*
plugins/
changes/
docs/offset-matching-audit.md
docs/remaining-audit-items.md
todo/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ── ECU binary files — never commit real ECU binaries ────────────────────────
*.bin
*.ori
*.BIN
*.ORI

# ── Rust native extension (compiled + build artefacts) ──────────────────────
openremap/_rust*.so
openremap/_rust*.dylib
openremap/_rust*.dll
openremap/*.so
openremap/_rs/target/

# ── Editor & OS ───────────────────────────────────────────────────────────────
.idea/
.vscode/
CLAUDE.md
todo.md
tests/data/
*.swp
*.swo
.DS_Store
Thumbs.db
